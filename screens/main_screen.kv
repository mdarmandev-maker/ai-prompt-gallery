<MainScreen>:
    # ==========================================
    # 1. MAIN APP CONTENT (Behind Splash Screen)
    # ==========================================
    MDNavigationLayout:
        
        ScreenManager:
            MDScreen:
                # App ka Background Dark/Gradient jaisa rakhna taaki glass chamke
                md_bg_color: 0.05, 0.05, 0.07, 1 

                # Ambient animated "aurora" gradient - poore screen ke peeche,
                # sab se pehle add kiya hai isliye baaki sab iske upar draw hota hai
                AmbientGradientBG:
                    size_hint: 1, 1

                MDBoxLayout:
                    orientation: 'vertical'

                    # Custom Premium Header (Bulletproof Background Image Layering)
                    MDFloatLayout:
                        size_hint_y: None
                        height: "64dp" 
                        
                        # BACKGROUND LAYER
                        # LAYER 1: Sabse peeche aapki background image
                        FitImage:
                            source: "assets/header_bg.jpg" 
                            size_hint: 1, 1
                            pos_hint: {"center_x": .5, "center_y": .5}

                        # LAYER 2: Uske upar aapke buttons, logo aur text
                        MDBoxLayout:
                            orientation: 'horizontal'
                            size_hint: 1, 1
                            pos_hint: {"center_x": .5, "center_y": .5}
                            padding: ["12dp", "8dp", "12dp", "8dp"]
                            spacing: "12dp"

                            # Left Icon (Menu or Back)
                            MDIconButton:
                                id: left_icon_btn
                                icon: "menu"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                pos_hint: {"center_y": .5}
                                on_release: root.open_menu_or_go_back()

                            # APP LOGO 
                            Image:
                                source: "assets/logo.png" 
                                size_hint: None, None
                                size: "40dp", "40dp" 
                                pos_hint: {"center_y": .5}

                            # Title
                            # --- TITLE WITH PREMIUM FADE SHADOW ---
                            MDRelativeLayout:
                                size_hint_x: 1 # Baaki bachi hui saari jagah cover karega

                                # 1. FADE SHADOW LAYER (Peeche wala text)
                                MDLabel:
                                    text: "AI Prompt Gallery"
                                    theme_text_color: "Custom"
                                    text_color: 0, 0, 0.2, 0.5 # 50% Transparent Black (Soft Fade)
                                    font_style: "H5"
                                    bold: True
                                    halign: "left"
                                    valign: "center"
                                    pos: "3dp", "-3dp" # Thoda right aur niche shift kiya shadow ke liye
                                    font_name: "assets/orbitron-bold.otf" 

                                # 2. MAIN TEXT LAYER (Upar wala safed text)
                                MDLabel:
                                    id: top_bar_title
                                    text: "AI Prompt Gallery"
                                    theme_text_color: "Custom"
                                    text_color: 1, 1, 1, 1 
                                    font_style: "H5"
                                    bold: True
                                    halign: "left"
                                    valign: "center"
                                    font_name: "assets/orbitron-bold.otf"

                            # Right Icon (Home)
                            MDIconButton:
                                id: right_icon_btn
                                icon: "home"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                pos_hint: {"center_y": .5}
                                opacity: 0 
                                disabled: True
                                on_release: root.filter_and_switch("All")

                    # Footer Navigation - GLASSMORPHISM EFFECT
                    MDBottomNavigation:
                        id: bottom_nav 
                        panel_color: 0.1, 0.1, 0.12, 0.85
                        text_color_active: app.theme_cls.primary_color
                        text_color_normal: 0.5, 0.5, 0.5, 1
                        use_text: True 

                        # Tab 1: Gallery (Home)
                        MDBottomNavigationItem:
                            name: 'screen_gallery'
                            text: 'Gallery'
                            icon: 'view-grid'

                            ScrollView:
                                do_scroll_x: False
                                MDBoxLayout:
                                    orientation: 'vertical'
                                    adaptive_height: True
                                    
                                    MDGridLayout:
                                        id: gallery_grid
                                        cols: 2
                                        adaptive_height: True
                                        row_default_height: "240dp"
                                        row_force_default: True
                                        padding: "16dp"
                                        spacing: "16dp"
                                        size_hint_x: 1 
                                        
                        # Tab 2: Categories
                        MDBottomNavigationItem:
                            name: 'screen_categories'
                            text: 'Categories'
                            icon: 'shape'

                            ScrollView:
                                do_scroll_x: False
                                MDBoxLayout:
                                    id: category_list
                                    orientation: 'vertical'
                                    adaptive_height: True
                                    padding: "16dp"
                                    spacing: "16dp"
                                    
                        # Tab 3: Prompt List
                        MDBottomNavigationItem:
                            name: 'screen_list'
                            text: 'List View'
                            icon: 'format-list-bulleted'

                            ScrollView:
                                do_scroll_x: False
                                MDBoxLayout:
                                    id: prompt_list
                                    orientation: 'vertical'
                                    adaptive_height: True
                                    padding: "16dp"
                                    spacing: "16dp"

                # "Surprise Me" - ek random prompt seedha khol deta hai.
                # Content ke upar float karta hai, bottom tab-bar se thoda upar.
                # Peeche ek breathing glow-ring hai jo FAB ki taraf dhyaan
                # kheenchta hai (infinite loop - MainScreen.fab_glow_alpha).
                MDFloatLayout:
                    size_hint: None, None
                    size: "72dp", "72dp"
                    pos_hint: {"right": 0.97, "y": 0.115}
                    canvas.before:
                        Color:
                            rgba: app.theme_cls.primary_color[0], app.theme_cls.primary_color[1], app.theme_cls.primary_color[2], root.fab_glow_alpha
                        Ellipse:
                            pos: self.pos
                            size: self.size

                    MDFloatingActionButton:
                        icon: "shuffle-variant"
                        md_bg_color: app.theme_cls.primary_color
                        pos_hint: {"center_x": .5, "center_y": .5}
                        on_release: root.show_random_prompt()

        # Sidebar Menu - GLASSMORPHISM EFFECT
        MDNavigationDrawer:
            id: nav_drawer
            radius: (0, 24, 24, 0) 
            md_bg_color: 0.08, 0.08, 0.1, 0.9 
            
            MDNavigationDrawerMenu:
                MDNavigationDrawerHeader:
                    title: "Md Arman"
                    text: "Visual Content Designer"
                    title_color: 1, 1, 1, 1
                    text_color: 0.7, 0.7, 0.7, 1
                    spacing: "8dp"
                    padding: "16dp", 0, 0, "48dp"

                MDNavigationDrawerItem:
                    icon: "information"
                    text: "About Us"
                    text_color: 1, 1, 1, 1
                    icon_color: 1, 1, 1, 1
                    on_release: root.show_about_us()

                MDNavigationDrawerItem:
                    icon: "email"
                    text: "Contact Us"
                    text_color: 1, 1, 1, 1
                    icon_color: 1, 1, 1, 1
                    on_release: root.show_contact_us()
                    
                MDNavigationDrawerItem:
                    icon: "shield-check"
                    text: "Privacy Policy"
                    text_color: 1, 1, 1, 1
                    icon_color: 1, 1, 1, 1
                    on_release: root.show_privacy_policy()

                MDNavigationDrawerItem:
                    icon: "file-document"
                    text: "Terms & Conditions"
                    text_color: 1, 1, 1, 1
                    icon_color: 1, 1, 1, 1
                    on_release: root.show_terms()

    # ==========================================
    # 2. SPLASH SCREEN OVERLAY (On Top)
    # ==========================================
    MDFloatLayout:
        id: splash_layout
        md_bg_color: 0.03, 0.03, 0.05, 1 
        opacity: 1

        Image:
            id: splash_logo
            source: "assets/logo.png"
            size_hint: None, None
            size: "40dp", "40dp"
            pos_hint: {"center_x": .5, "center_y": .55}
            allow_stretch: True
            keep_ratio: True

        MDLabel:
            text: "AI Prompt Gallery"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_style: "H5"
            bold: True
            halign: "center"
            pos_hint: {"center_x": .5, "center_y": .4}
            
        MDLabel:
            text: "By Md Arman"
            theme_text_color: "Custom"
            text_color: 0.5, 0.5, 0.5, 1
            font_style: "Caption"
            halign: "center"
            pos_hint: {"center_x": .5, "center_y": .35}

        MDSpinner:
            size_hint: None, None
            size: "40dp", "40dp"
            pos_hint: {"center_x": .5, "center_y": .2}
            active: True
            color: app.theme_cls.primary_color
